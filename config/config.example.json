{
  "display": {
    "fullscreen": false,
    "window_width": 1280,
    "window_height": 720,
    "font_size": 48,
    "font_min": 24,
    "font_max": 96,
    "font_step": 4,
    "foreground": "#FFFFFF",
    "background": "#000000",
    "margin_percent": 5,
    "line_spacing": 4
  },
  "system": {
    "development_mode": true,
    "allow_keyboard": true,
    "show_splash": false,
    "splash_duration_ms": 1500
  },
  "songs": {
    "source_mode": "directory",
    "directory": "demo_songs",
    "linux_mount_path": "",
    "encoding": "utf-8-sig",
    "extension": ".txt",
    "sort_mode": "numeric_prefix",
    "recursive": false
  },
  "input": {
    "shutdown_key": "down",
    "shutdown_hold_ms": 15000
  },
  "lyrics_following": {
    "enabled": false,
    "mode": "observe",
    "audio_source": "windows_loopback",
    "audio_device": "default",
    "language": "de",
    "model": "small",
    "beam_size": 5,
    "window_seconds": 6,
    "overlap_seconds": 2,
    "use_initial_prompt": false,
    "hotwords": "",
    "confidence_threshold": 0.75,
    "pause_duration_ms": 800,
    "prefer_pause": true,
    "min_turn_interval_ms": 5000,
    "highlight_current_line": true,
    "auto_page_turn": false
  }
}
