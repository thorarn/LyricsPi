{
  "display": {
    "fullscreen": false,
    "window_width": 1280,
    "window_height": 720,
    "font_size": 48,
    "font_min": 24,
    "font_max": 96,
    "font_step": 4,
    "foreground": "#FFFFFF",
    "background": "#000000",
    "margin_percent": 5,
    "line_spacing": 4
  },
  "system": {
    "development_mode": true,
    "allow_keyboard": true,
    "show_splash": false
  },
  "songs": {
    "source_mode": "directory",
    "directory": "demo_songs",
    "linux_mount_path": "",
    "encoding": "utf-8-sig",
    "extension": ".txt",
    "sort_mode": "numeric_prefix",
    "recursive": false
  },
  "input": {
    "shutdown_key": "down",
    "shutdown_hold_ms": 15000
  }
}
